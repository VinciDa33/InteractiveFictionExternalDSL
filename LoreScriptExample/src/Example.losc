lorescript MyLoreScript

scenario PlayerCustomization {
	event Welcome {
		text: "Welcome! " + "Lets find out who you are!"
		goto: PlayerName
	}
	
	event PlayerName {
		text: "Is your name " + $potentialPlayerName + "?"
		option {
			text: "Yes, thats it!"
			trigger lockName()
			goto: AbilityIntro
		}
		option {
			text: "No, try again!"
			goto: PlayerName
		}
	}
	
	event AbilityIntro {
		text: "Next up, what is your secret move?"
		goto: PlayerAbility
	}
	
	event PlayerAbility {
		text: "Do you have the ability to " + $potentialPlayerAbility + "?"
		option {
			text: "Yup, thats what I do!"
			trigger lockAbility()
			goto: PlayerFinal
		}
		option {
			text: "Nah, thats not what I do!"
			goto: PlayerAbility
		}
	}
	
	event PlayerFinal {
		text: "So you are " + $playerName + " and you have the ability to " + $playerAbility + "."
		option {
			text: "Heck yeah!"
			goto: Combat.Start
		}
		option {
			text: "Nope, all wrong. Lets start over!"
			trigger clearPlayer()
			goto: PlayerName
		}
	}
}

scenario Combat {
	event Start {
		text: "Welcome to trial by combat! Todays contestants are Volf the Voracious! vs " + $playerName + "!"
		goto: Fight1
	}
	
	event Fight1 {
		text: "A big hairy guy stands before you! What will you do?"
		option {
			text: "I prepare to dodge!"
			goto: Fight1Dodge
		}
		option {
			text: "I do a high kick!"
			goto: Fight1Kick
		}
		option {
			text: "I punch him in the face"
			goto: Fight1Punch
		}
	}
	
	event Fight1Dodge {
		text: "Volf swings his mighty fists in a flurry of blows, but you dodge out of the way completely!"
		trigger logMove("Dodge")
		goto: Fight2
	}
	
	event Fight1Kick {
		text: "You kick Volf in the jaw. He seems noticable rattled, but still standing!"
		trigger enemyDamage(15)
		trigger logMove("Kick")
		goto: Fight2
	}
	
	event Fight1Punch {
		text: "You punch Volf in the face. His face feels like a rock. You take a bit of damage"
		trigger playerDamage(5)
		trigger logMove("Punch")
		goto: Fight2
		
	}
	
	event Fight2 {
		text: "Time is running by fast, with only a few moments on the clock whaw will you do?"
		option {
			text: "I do a leg sweep!"
			goto: Fight2Sweep
		}
		option {
			text: "I use my special ability!"
			goto: Fight2Special
		}
		option {
			text: "I run away to run down the clock!"
			goto: Fight2Run
		}
	}
	
	event Fight2Sweep {
		text: "Volf falls heavily to the ground."
		trigger enemyDamage(10)
		trigger logMove("Sweep")
		goto: Clock
	}
	
	event Fight2Special {
		text: $playerAbilityDescription
		trigger logMove("Special")
		goto: Clock
	}
	
	event Fight2Run {
		text: "You run away, screaming to confuse your larger enemey."
		trigger logMove("Run")
		goto: Clock
	}
	
	event Clock {
		text: "Ding ding ding. The clock is up, and it is time to declare the winner!"
		goto: Winner
	}
	
	event Winner {
		text: $winnerText
	}
}
