event Entrance {
	text: "This is the text for this event!"
	goto: TopFloor
}

event TopFloor {
	text: "There are 3 trinkets on a counter, which one do you pick up?"
	option {
		text: "Hello"
		goto: TrinketOne
	}
	option {
		text: "Yeet"
		goto: TrinketTwo
	}
	option {
		text: "Meth"
		goto: Meth
	}
}

event Meth {
	text: "You take meth and die!"
}