lorescript MyLoreScript

scenario HauntedHouse {
	event Entrance {
		text: "Welcome " + get("player_name") + "! " + "You stand in the entrance!"
		goto: Hallway
	}
	
	event Hallway {
		text: "You enter a hallway. There are 3 doors. Which one do you pick?"
		option {
			text: "Door One. On the left."
			goto: EmptyRoom
		}
		option {
			text: "Door two. Straight ahead."
			goto: Wacko
		}
		option {
			text: "Door three. On your right."
			goto: TrinketRoom
		}
	}
	
	event EmptyRoom {
		text: "You enter an empty room. You pass through it."
		goto: BallRoom
	}
	
	event TrinketRoom {
		text: "You enter a room with a curious goblet situated on a small pedestal. Do you grab the goblet?"
		option {
			text: "Yes! " + "the loot is mine!"
			goto: Terminal
		}
		option {
			text: "No. " + "I return to the hallway."
			goto: Hallway
		}
	}
	
	event BallRoom {
		text: "You enter a large ballroom. A figure wants to dance. Do you wish to dance?"
		option {
			text: "Yes."
			goto: Terminal
		}
		option {
			text: "No. I leave!"
			goto: Hallway
		}
	}
	
	event Wacko {
		text: "You enter a wacko room!"
		goto: Hallway
	}
	
	event Terminal {
		text: "Death!"
		goto: Hell.Welcome
	}
}

scenario Hell {
	event Welcome {
		text: "You died and have ended up in hell. A demon greets you!"
		goto: DemonsChoice
	}
	
	event DemonsChoice {
		text: "The demon gives you a choice!"
		option {
			text: "Surrender your soul, but be revived!"
			goto: HauntedHouse.Entrance
		}
		option {
			text: "Work in the burning flames of hell for an eternity (free housing)"
			goto: Eternity
		}
		option {
			text: "Listen to an old radio for 1 full year!"
			goto: Radio
		}
	}
	
	event Eternity {
		text: "You become a demon. Forever."
	}
	
	event Radio {
		text: "You are sat before the radio. Its noises are terrible and the sound is garbled." +
		"A glitchy male voice speaks. " + "Co-" * 3 + "Combo breaker!"
	}
}
